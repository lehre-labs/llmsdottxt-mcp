# llmsdottxt-mcp is convention-based; every setting is optional and has a sane default.
# Override via OS environment variables or a .env / .env.local file.
# All variables are prefixed with LLMSTXT_.

# Where the local index + cache live (default: ~/.llms.txt.d)
# LLMSTXT_INDEX_ROOT=~/.llms.txt.d

# Parallel docs fetches during a scan (default: 5)
# LLMSTXT_MAX_CONCURRENT_FETCHES=5

# Hard cap on llms-full.txt held in memory, in bytes (default: 20 MB)
# LLMSTXT_MAX_FULL_TEXT_SIZE=20971520

# Per-host requests per minute for the shared rate limiter (default: 60)
# LLMSTXT_RATE_LIMIT_PER_MINUTE=60

# Log level for the structlog logger written to stderr (default: INFO)
# LLMSTXT_LOG_LEVEL=INFO
